{
  "name": "kreapro-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site de l'agence web & design KréaPro (La Réunion) - style Tropical / Minimaliste",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "serve": "npx serve . -l 5500",
    "test:e2e": "node --test \"tests/e2e/*.test.js\""
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.13"
  }
}
